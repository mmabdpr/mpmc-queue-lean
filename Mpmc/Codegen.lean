/-
  Print the verified kernel programs as C.

  The output is checked in as `include/mpmc/detail/kernel.inc` and included by
  `src/mpmc.c` after the internal layout definitions.  CI regenerates it and
  fails on a diff, so the shipped C always corresponds to the programs whose
  semantics `Mpmc.Kernel.run` interprets.
-/

import Mpmc.Kernel

open Mpmc.Kernel

namespace Mpmc.Codegen

def ordStr : MemOrd → String
  | .relaxed => "__ATOMIC_RELAXED"
  | .acquire => "__ATOMIC_ACQUIRE"
  | .release => "__ATOMIC_RELEASE"
  | .acqRel => "__ATOMIC_ACQ_REL"
  | .seqCst => "__ATOMIC_SEQ_CST"

def hintStr : Hint → String
  | .write => "write_index"
  | .read => "read_index"

def exprStr : Expr → String
  | .var n => "r" ++ toString n
  | .param .capacity => "capacity"
  | .param .mask => "mask"
  | .param .limit => "limit"
  | .param .value => "value"
  | .lit v => "UINT64_C(" ++ toString v.toNat ++ ")"
  | .add a b => "((" ++ exprStr a ++ ") + (" ++ exprStr b ++ "))"
  | .sub a b => "((" ++ exprStr a ++ ") - (" ++ exprStr b ++ "))"
  | .mul a b => "((" ++ exprStr a ++ ") * (" ++ exprStr b ++ "))"
  | .band a b => "((" ++ exprStr a ++ ") & (" ++ exprStr b ++ "))"
  | .bor a b => "((" ++ exprStr a ++ ") | (" ++ exprStr b ++ "))"
  | .shl a b => "((" ++ exprStr a ++ ") << (" ++ exprStr b ++ "))"
  | .shr a b => "((" ++ exprStr a ++ ") >> (" ++ exprStr b ++ "))"
  | .eq a b => "((" ++ exprStr a ++ ") == (" ++ exprStr b ++ "))"
  | .ne a b => "((" ++ exprStr a ++ ") != (" ++ exprStr b ++ "))"
  | .ult a b => "((" ++ exprStr a ++ ") < (" ++ exprStr b ++ "))"
  | .ule a b => "((" ++ exprStr a ++ ") <= (" ++ exprStr b ++ "))"

def opStr : Op → String
  | .set r e => "r" ++ toString r ++ " = " ++ exprStr e ++ ";"
  | .loadCell m p slot ord =>
      "{ mpmc_cell _cell = mpmc_load_cell(&mpmc_slots(q)[" ++ exprStr slot ++
      "].value, " ++ ordStr ord ++ "); r" ++ toString m ++ " = _cell.marker; r" ++
      toString p ++ " = _cell.payload; }"
  | .casCell r slot em ep dm dp okOrd failOrd =>
      "r" ++ toString r ++ " = mpmc_cas_cell(&mpmc_slots(q)[" ++ exprStr slot ++
      "].value, " ++ exprStr em ++ ", " ++ exprStr ep ++ ", " ++ exprStr dm ++
      ", " ++ exprStr dp ++ ", " ++ ordStr okOrd ++ ", " ++
      ordStr failOrd ++ ");"
  | .loadHint r which ord =>
      "r" ++ toString r ++ " = mpmc_load_u64(&q->" ++ hintStr which ++
      ", " ++ ordStr ord ++ ");"
  | .casHint r which expected desired ord =>
      "r" ++ toString r ++ " = mpmc_cas_u64(&q->" ++ hintStr which ++ ", " ++
      exprStr expected ++ ", " ++ exprStr desired ++ ", " ++ ordStr ord ++
      ");"
  | .storeOut which e => "*out" ++ toString which ++ " = " ++ exprStr e ++ ";"

def termStr : Term → String
  | .goto b => "goto L" ++ toString b ++ ";"
  | .branch c t f =>
      "if " ++ exprStr c ++ " { goto L" ++ toString t ++ "; } else { goto L" ++
      toString f ++ "; }"
  | .ret e => "return " ++ exprStr e ++ ";"
  | .trap => "__builtin_trap();"

def blockStr (i : Nat) (b : Block) : String :=
  let label := "L" ++ toString i ++ ":"
  let body := String.intercalate "\n  " (b.ops.map opStr)
  if body.isEmpty then
    label ++ "\n  " ++ termStr b.term
  else
    label ++ "\n  " ++ body ++ "\n  " ++ termStr b.term

def programStr (p : Program) : String :=
  let valueParam := if p.params.contains .value then ", uint64_t value" else ""
  let outParams :=
    String.join ((List.range p.outCount).map
      (fun i => ", uint64_t *out" ++ toString i))
  let signature :=
    "static inline uint64_t " ++ p.name ++ "(struct mpmc_queue *q" ++
    ", uint64_t capacity, uint64_t mask, uint64_t limit" ++
    valueParam ++ outParams ++ ") {"
  let regs :=
    "  uint64_t " ++
    String.intercalate ", "
      ((List.range p.regCount).map (fun i => "r" ++ toString i ++ " = 0")) ++
    ";"
  let blocks :=
    String.intercalate "\n" ((List.range p.blocks.length).map
      (fun i =>
        match p.blocks[i]? with
        | some b => blockStr i b
        | none => ""))
  signature ++ "\n" ++ regs ++ "\n  goto L" ++ toString p.entry ++ ";\n" ++
    blocks ++ "\n}"

def header : String :=
  "/* Generated by `lake exe mpmc-codegen` from Mpmc/Kernel.lean.\n" ++
  "   Do not edit by hand; regenerate and commit. */\n\n" ++
  "static inline uint64_t mpmc_cas_cell(mpmc_cell *c, uint64_t em,\n" ++
  "                                     uint64_t ep, uint64_t dm,\n" ++
  "                                     uint64_t dp, int ok, int fail) {\n" ++
  "  mpmc_cell expected = {em, ep};\n" ++
  "  mpmc_cell desired = {dm, dp};\n" ++
  "  return __atomic_compare_exchange(c, &expected, &desired, 0, ok, fail)\n" ++
  "             ? 1\n" ++
  "             : 0;\n" ++
  "}\n\n" ++
  "static inline uint64_t mpmc_cas_u64(uint64_t *p, uint64_t expected,\n" ++
  "                                    uint64_t desired, int order) {\n" ++
  "  return __atomic_compare_exchange_n(p, &expected, desired, 0, order,\n" ++
  "                                     __ATOMIC_RELAXED)\n" ++
  "             ? 1\n" ++
  "             : 0;\n" ++
  "}\n\n"

def render : String :=
  "/*\n" ++
  " * Copyright (c) 2026 Mohammad Mahdi Abdollahpour.\n" ++
  " * The contents of this file are subject to the Common Public Attribution\n" ++
  " * License Version 1.0 (the \"License\"); you may not use this file except in\n" ++
  " * compliance with the License. You may obtain a copy of the License at\n" ++
  " * https://opensource.org/license/cpal-1-0.\n" ++
  " * The Original Code is mpmc-lean. The Initial Developer is Mohammad Mahdi\n" ++
  " * Abdollahpour. See LICENSE and NOTICE.\n" ++
  " */\n\n" ++
  "#ifndef MPMC_LEAN_KERNEL_INC\n" ++
  "#define MPMC_LEAN_KERNEL_INC\n\n" ++
  header ++ programStr pushProgram ++ "\n\n" ++ programStr popProgram ++ "\n" ++
  "\n#endif /* MPMC_LEAN_KERNEL_INC */\n"

end Mpmc.Codegen

def main : IO Unit := do
  IO.FS.createDirAll "include"
  IO.FS.writeFile "include/mpmc/detail/kernel.inc" Mpmc.Codegen.render
  IO.println "wrote include/mpmc/detail/kernel.inc"
