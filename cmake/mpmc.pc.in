prefix=${pcfiledir}/@MPMC_PC_PREFIX_REL@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: mpmc
Description: Bounded MPMC queue with a machine-checked SC kernel-event core and a C ABI
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lmpmc @MPMC_PC_LIBS@
Cflags: -I${includedir} @MPMC_PC_CFLAGS@
